{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aapkakhet",
  "main": "worker/index.js",
  // Custom domain (a subdomain of a zone already on this Cloudflare account)
  "routes": [{ "pattern": "aapkakhet.readhaven.online", "custom_domain": true }],
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_ORIGIN": "https://aapkakhet-api.azurewebsites.net"
  },
  // Keep the free-tier API warm (see scheduled() in worker/index.js)
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
